# ==============================================================================
# PortHarcourtSchools — Environment Configuration
# Copy this file to .env.local and fill in your secrets.
# All variables with fallbacks will allow the application to boot without crashing.
# ==============================================================================

# --- 1. Database (Neon Postgres) ---
# Connection string from your Neon Database console
DATABASE_URL="postgresql://user:password@erequirep-sample-pooler.region.neon.tech/neondb?sslmode="

# --- 2. NextAuth.js (Authentication) ---
# A random 32-character string. Generate with: openssl rand -base64 32
AUTH_SECRET="your_32_character_auth_secret_here"
# The canonical URL where this app is hosted (e.g. http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- 3. Upstash Redis (Caching & Rate Limiting) ---
# Optional: If unset, application automatically uses high-speed in-memory caching.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# --- 4. Cloudflare R2 (Media Storage & Uploads) ---
# S3-compatible credentials from Cloudflare R2 bucket settings.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="portharcourtschools"
# Public custom domain or r2.dev domain for serving uploaded images
R2_PUBLIC_URL="https://media.portharcourtschools.com"

# --- 5. Cloudflare Turnstile (Bot & Spam Protection) ---
# Site key (client-side) and Secret key (server-side) from Cloudflare dashboard
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- 6. Resend (Email Delivery) ---
# API key from resend.com
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="PortHarcourtSchools <notifications@portharcourtschools.com>"
ADMIN_NOTIFICATION_EMAIL="admin@portharcourtschools.com"